# Seha — variables de PRODUCTION (VPS). Copiez en .env sur le serveur :
#   cp .env.prod.example .env  &&  nano .env
# Ne committez JAMAIS le vrai .env (il est déjà dans .gitignore).

# --- Domaine (obligatoire) ---
# Doit pointer (enregistrement DNS A) vers l'IP publique du VPS.
DOMAIN=seha.tn

# --- Base de données (obligatoire) ---
POSTGRES_USER=seha
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort
POSTGRES_DB=seha

# --- Sessions (obligatoire) ---
# Générez une valeur forte : openssl rand -base64 32
SESSION_SECRET=CHANGEZ_MOI_openssl_rand_base64_32

# --- SMS pour l'OTP (recommandé en prod) ---
# Sans passerelle, le code OTP est renvoyé dans la réponse (mode dev) au lieu
# d'être envoyé par SMS. Branchez un agrégateur tunisien (Konnect, Orange…).
# SMS_GATEWAY_URL=
# SMS_GATEWAY_TOKEN=

# --- Réponse IA aux questions (optionnel) ---
# ANTHROPIC_API_KEY=
