# Tabibi — variables d'environnement (copiez en .env)

# --- Base de données (mode « cloud ») ---
# En local avec docker compose, elle est fournie automatiquement.
# Sur Vercel : créez une base Neon/Postgres, la variable est injectée.
DATABASE_URL="postgresql://tabibi:tabibi@localhost:5432/tabibi?schema=public"

# --- Sessions (obligatoire en cloud) ---
# Générez : openssl rand -base64 32
SESSION_SECRET="change-me"

# --- Connexion Google (optionnel) ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# --- Réponse IA aux questions médicales (optionnel) ---
# ANTHROPIC_API_KEY=""

# --- Passerelle SMS pour l'OTP (optionnel) ---
# Orange / Ooredoo / Tunisie Télécom ou agrégateur (Konnect…)
# SMS_GATEWAY_URL=""
# SMS_GATEWAY_TOKEN=""
